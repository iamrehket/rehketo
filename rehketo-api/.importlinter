[importlinter]
root_package = rehketo

[importlinter:contract:auth-permissions-never-import-api]
name = auth and permissions never depend on api
type = forbidden
source_modules =
    rehketo.auth
    rehketo.permissions
forbidden_modules =
    rehketo.api

[importlinter:contract:db-isolated]
name = db does not depend on app layers
type = forbidden
source_modules =
    rehketo.db
forbidden_modules =
    rehketo.api
    rehketo.auth
    rehketo.permissions

[importlinter:contract:core-foundational]
name = core is foundational
type = forbidden
source_modules =
    rehketo.core
forbidden_modules =
    rehketo.api
    rehketo.auth
    rehketo.permissions
    rehketo.db
    rehketo.config

[importlinter:contract:mcp-layering]
name = mcp depends only on db, permissions, runs, auth crypto, core, config
type = forbidden
source_modules =
    rehketo.mcp
forbidden_modules =
    rehketo.api
    rehketo.agent

[importlinter:contract:api-never-imports-mcp]
name = api does not import mcp directly (goes through agent.run)
type = forbidden
source_modules =
    rehketo.api
forbidden_modules =
    rehketo.mcp
allow_indirect_imports = True
